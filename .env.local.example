# Sanity CMS — Configurare
# Copiază acest fișier ca .env.local și completează valorile
# Obții Project ID de pe sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=not-configured
NEXT_PUBLIC_SANITY_DATASET=production

# Formular de contact (opțional) — ID-ul formularului de pe formspree.io.
# Fără el, formularul deschide aplicația de email a vizitatorului.
NEXT_PUBLIC_FORMSPREE_ID=
